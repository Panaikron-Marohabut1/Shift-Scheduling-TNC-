# Copy to apps/auth/.env.local and fill in. Never commit .env.local.
# Supabase project URL and publishable (anon) key. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Exact origins allowed to receive the login redirect (comma-separated).
TRUSTED_APP_ORIGINS=http://localhost:3000
# Keep false for local and test environments.
SHARE_AUTH_COOKIE=false
# Development only: email domains allowed to sign in with email/password.
# The demo test accounts in the root README use shiftflow.test.
DEV_ALLOWED_EMAIL_DOMAINS=shiftflow.test
